<Window x:Class="LePaSentinel.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:LePaSentinel"
        Title="{x:Static local:L.Title}" Width="380" SizeToContent="Height"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        Topmost="True" ShowInTaskbar="False" ResizeMode="NoResize" ShowActivated="True"
        FontFamily="Segoe UI" FontSize="12"
        UseLayoutRounding="True" SnapsToDevicePixels="True"
        TextOptions.TextFormattingMode="Display">

    <Window.Resources>
        <SolidColorBrush x:Key="Fg" Color="#ECECEF"/>
        <SolidColorBrush x:Key="Muted" Color="#8E909A"/>
        <SolidColorBrush x:Key="Working" Color="#4C9AFF"/>
        <SolidColorBrush x:Key="Waiting" Color="#FFA23E"/>
        <SolidColorBrush x:Key="Done" Color="#3DD68C"/>
        <SolidColorBrush x:Key="Idle" Color="#6B6E78"/>

        <Style x:Key="HeaderButton" TargetType="Button">
            <Setter Property="Width" Value="24"/>
            <Setter Property="Height" Value="24"/>
            <Setter Property="Margin" Value="2,0,0,0"/>
            <Setter Property="Foreground" Value="{StaticResource Muted}"/>
            <Setter Property="FontFamily" Value="Segoe Fluent Icons, Segoe MDL2 Assets"/>
            <Setter Property="FontSize" Value="9"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Focusable" Value="False"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bg" CornerRadius="6" Background="Transparent">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bg" Property="Background" Value="#1FFFFFFF"/>
                                <Setter Property="Foreground" Value="{StaticResource Fg}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style TargetType="ScrollBar">
            <Setter Property="Width" Value="6"/>
            <Setter Property="MinWidth" Value="6"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ScrollBar">
                        <Track x:Name="PART_Track" IsDirectionReversed="True">
                            <Track.Thumb>
                                <Thumb>
                                    <Thumb.Template>
                                        <ControlTemplate TargetType="Thumb">
                                            <Border CornerRadius="3" Background="#40FFFFFF"/>
                                        </ControlTemplate>
                                    </Thumb.Template>
                                </Thumb>
                            </Track.Thumb>
                        </Track>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- One header counter: coloured dot + number -->
        <Style x:Key="CountText" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{StaticResource Fg}"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Margin" Value="4,0,10,0"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>
    </Window.Resources>

    <Grid x:Name="FullView" Margin="10">
        <!-- Separate shadow layer keeps the text crisp -->
        <Border CornerRadius="12" Background="#1C1D22">
            <Border.Effect>
                <DropShadowEffect BlurRadius="18" ShadowDepth="3" Opacity="0.5" Color="Black"/>
            </Border.Effect>
        </Border>

        <Border CornerRadius="12" Background="#F21C1D22" BorderBrush="#2AFFFFFF" BorderThickness="1">
            <StackPanel>
                <Grid x:Name="Header" Height="36" Margin="12,0,6,0" Background="Transparent"
                      MouseLeftButtonDown="Header_MouseLeftButtonDown"
                      ToolTip="{x:Static local:L.HeaderTip}">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <Ellipse x:Name="HeaderDot" Width="9" Height="9" Fill="{StaticResource Idle}"
                             VerticalAlignment="Center" Margin="0,0,9,0"/>
                    <TextBlock x:Name="TitleText" Grid.Column="1" Text="{x:Static local:L.Title}" FontWeight="SemiBold"
                               FontSize="13" Foreground="{StaticResource Fg}" VerticalAlignment="Center"
                               Margin="0,0,12,0"/>

                    <StackPanel Grid.Column="3" Orientation="Horizontal" VerticalAlignment="Center">
                        <StackPanel x:Name="CountWaitingPanel" Orientation="Horizontal" ToolTip="{x:Static local:L.CountWaitingTip}">
                            <Ellipse Width="7" Height="7" Fill="{StaticResource Waiting}" VerticalAlignment="Center"/>
                            <TextBlock x:Name="CountWaiting" Style="{StaticResource CountText}"/>
                        </StackPanel>
                        <StackPanel x:Name="CountWorkingPanel" Orientation="Horizontal" ToolTip="{x:Static local:L.CountWorkingTip}">
                            <Ellipse Width="7" Height="7" Fill="{StaticResource Working}" VerticalAlignment="Center"/>
                            <TextBlock x:Name="CountWorking" Style="{StaticResource CountText}"/>
                        </StackPanel>
                        <StackPanel x:Name="CountDonePanel" Orientation="Horizontal" ToolTip="{x:Static local:L.CountDoneTip}">
                            <Ellipse Width="7" Height="7" Fill="{StaticResource Done}" VerticalAlignment="Center"/>
                            <TextBlock x:Name="CountDone" Style="{StaticResource CountText}"/>
                        </StackPanel>
                        <StackPanel x:Name="CountIdlePanel" Orientation="Horizontal" ToolTip="{x:Static local:L.CountIdleTip}">
                            <Ellipse Width="7" Height="7" Fill="{StaticResource Idle}" VerticalAlignment="Center"/>
                            <TextBlock x:Name="CountIdle" Style="{StaticResource CountText}"/>
                        </StackPanel>
                        <TextBlock x:Name="CountNone" Text="{x:Static local:L.NoSessions}" Foreground="{StaticResource Muted}"
                                   VerticalAlignment="Center" Margin="0,0,10,0"/>
                    </StackPanel>

                    <Button x:Name="SoundButton" Grid.Column="4" Style="{StaticResource HeaderButton}"
                            FontSize="12" Click="SoundButton_Click"/>
                    <Button x:Name="PinButton" Grid.Column="5" Style="{StaticResource HeaderButton}"
                            FontSize="12" Click="PinButton_Click"/>
                    <Button Grid.Column="6" Style="{StaticResource HeaderButton}" Content="&#xE8BB;"
                            Click="HideButton_Click" ToolTip="{x:Static local:L.CloseTip}"/>
                </Grid>

                <StackPanel x:Name="Body">
                    <Border Height="1" Background="#18FFFFFF"/>
                    <ScrollViewer MaxHeight="560" VerticalScrollBarVisibility="Auto"
                                  HorizontalScrollBarVisibility="Disabled" Padding="0,4,0,6">
                        <ItemsControl x:Name="List">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border x:Name="Card" Margin="6,2" Padding="10,7,10,8" CornerRadius="8"
                                            Background="Transparent" Cursor="Hand" ToolTip="{Binding Tooltip}"
                                            MouseLeftButtonUp="Card_MouseLeftButtonUp">
                                        <Border.ContextMenu>
                                            <ContextMenu>
                                                <MenuItem Header="{x:Static local:L.MenuGoTo}" Click="MenuOpenCode_Click"/>
                                                <MenuItem Header="{x:Static local:L.MenuOpenFolder}" Click="MenuOpenFolder_Click"/>
                                                <Separator/>
                                                <MenuItem Header="{x:Static local:L.MenuRemove}" Click="MenuRemove_Click"/>
                                            </ContextMenu>
                                        </Border.ContextMenu>
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto"/>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <Grid.RowDefinitions>
                                                <RowDefinition Height="Auto"/>
                                                <RowDefinition Height="Auto"/>
                                            </Grid.RowDefinitions>

                                            <Ellipse x:Name="Dot" Width="8" Height="8" Fill="{Binding StatusBrush}"
                                                     VerticalAlignment="Center" Margin="0,0,9,0"/>
                                            <TextBlock Grid.Column="1" Text="{Binding Project}" FontWeight="SemiBold"
                                                       Foreground="{StaticResource Fg}" TextTrimming="CharacterEllipsis"/>
                                            <TextBlock Grid.Column="2" Text="{Binding TimeText}" Foreground="{Binding TimeBrush}"
                                                       FontFamily="Cascadia Mono, Consolas" FontSize="11"
                                                       VerticalAlignment="Center" Margin="10,0,0,0"/>
                                            <TextBlock Grid.Row="1" Grid.Column="1" Grid.ColumnSpan="2" Text="{Binding Subtitle}"
                                                       Foreground="{StaticResource Muted}" TextTrimming="CharacterEllipsis"
                                                       Margin="0,2,0,0"/>
                                        </Grid>
                                    </Border>
                                    <DataTemplate.Triggers>
                                        <DataTrigger Binding="{Binding IsWaiting}" Value="True">
                                            <Setter TargetName="Card" Property="Background" Value="#1FFFA23E"/>
                                        </DataTrigger>
                                        <Trigger SourceName="Card" Property="IsMouseOver" Value="True">
                                            <Setter TargetName="Card" Property="Background" Value="#14FFFFFF"/>
                                        </Trigger>
                                        <DataTrigger Binding="{Binding IsWorking}" Value="True">
                                            <DataTrigger.EnterActions>
                                                <BeginStoryboard x:Name="Pulse">
                                                    <Storyboard>
                                                        <DoubleAnimation Storyboard.TargetName="Dot" Storyboard.TargetProperty="Opacity"
                                                                         From="1" To="0.2" Duration="0:0:0.9"
                                                                         AutoReverse="True" RepeatBehavior="Forever"/>
                                                    </Storyboard>
                                                </BeginStoryboard>
                                            </DataTrigger.EnterActions>
                                            <DataTrigger.ExitActions>
                                                <StopStoryboard BeginStoryboardName="Pulse"/>
                                            </DataTrigger.ExitActions>
                                        </DataTrigger>
                                    </DataTemplate.Triggers>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>
                    <TextBlock x:Name="EmptyText" Foreground="{StaticResource Muted}" Margin="16,6,16,12"
                               TextWrapping="Wrap"
                               Text="{x:Static local:L.Empty}"/>
                </StackPanel>
            </StackPanel>
        </Border>
    </Grid>
</Window>
